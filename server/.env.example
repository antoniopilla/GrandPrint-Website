# ── Server ──────────────────────────────────────────────
PORT=5000
# Set to production on Render to enforce HTTPS payment-link configuration.
NODE_ENV=
# Local: mongodb://127.0.0.1:27017/printingPOS
# Production: your MongoDB Atlas connection string (mongodb+srv://...)
MONGO_URI=

# Comma-separated list of allowed frontend origins (CORS).
# Leave blank in local dev to allow all. In production:
# CLIENT_URL=https://grandprint.vercel.app
CLIENT_URL=

# Canonical payment-link base. Required HTTPS URL in production.
CUSTOMER_PORTAL_URL=

# Leave disabled until proxy/client IP handling is confirmed. Only "true" enables it.
# Limits are per process and reset when the server restarts.
# false
ORDER_ACCESS_RATE_LIMIT_ENABLED=

# ── Auth ────────────────────────────────────────────────
ADMIN_PASSWORD=
JWT_SECRET=

# ── Email (Brevo HTTP API) ──────────────────────────────
# EMAIL_USER is the "from" address — must be a VERIFIED sender in Brevo.
EMAIL_USER=
BREVO_API_KEY=
BUSINESS_NAME=GrandPrint

# ── Cloudinary (file storage) ───────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Payment details (shown in approval email) ───────────
GCASH_NAME=
GCASH_NUMBER=
BPI_NAME=
BPI_ACCOUNT=
FB_PAGE=
